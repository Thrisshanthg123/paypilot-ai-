# Copy to backend/.env. Never commit secrets.
APP_ENV=development
API_PREFIX=/api
DATABASE_URL=sqlite:///./fraudshield.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI engine developed by Member 3. Set AI_ENGINE_URL to its analyze endpoint.
# Missing/unreachable AI service fails closed. Set AI_MODE=mock only for local demos.
AI_MODE=remote
AI_ENGINE_URL=
AI_ENGINE_API_KEY=
AI_TIMEOUT_SECONDS=5

# PayPal Developer Sandbox credentials. Set both values to enable real sandbox calls.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_RETURN_URL=http://localhost:5173/paypal/return
PAYPAL_CANCEL_URL=http://localhost:5173/paypal/cancel
PAYPAL_TIMEOUT_SECONDS=10

